[resource]
script = ExtResource("1_species")
species_id = &"monitorz"
atlas_number = 25
display_name = "Monitorz"
short_description = "A hardy reptile that feels at home both in water and on land. It eagerly hunts for hidden treasures."
rarity = &"common"
animal_inspiration = "Nile Monitor (Varanus niloticus)"
habitat_tags = Array[StringName]([&"riverbank", &"marsh", &"woodland"])
temperament_tags = Array[StringName]([&"curious", &"hardy", &"aggressive"])
