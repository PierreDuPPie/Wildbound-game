[resource]
script = ExtResource("1_species")
species_id = &"zebrafly"
atlas_number = 10
display_name = "Zebrafly"
short_description = "A dazzling equine with hypnotic stripes that confuse predators. It kicks wildly when backed into a corner."
rarity = &"common"
animal_inspiration = "Plains Zebra (Equus quagga)"
habitat_tags = Array[StringName]([&"savannah", &"grassland", &"scrubland"])
temperament_tags = Array[StringName]([&"social", &"alert", &"defensive"])
aspects = Array[ExtResource("5_aspect_type")]([ExtResource("2_aspect")])
instinct = ExtResource("3_instinct")
base_vitality = 50
base_power = 45
base_guard = 40
base_agility = 60
base_focus = 30
base_instinct = 45
growth_curve = &"steady"
base_bond_difficulty = 50
learnset = Array[ExtResource("6_move_type")]([ExtResource("m_sun_dash"), ExtResource("m_scale_bash"), ExtResource("default_sun_skip")])
