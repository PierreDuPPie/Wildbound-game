[resource]
script = ExtResource("1_species")
species_id = &"springer"
atlas_number = 29
display_name = "Springer"
short_description = "A bizarre, nocturnal hopper that springs erratically to avoid danger. It digs elaborate warrens under the moonlight."
rarity = &"common"
animal_inspiration = "Springhare (Pedetes capensis)"
habitat_tags = Array[StringName]([&"savannah", &"grassland", &"desert"])
temperament_tags = Array[StringName]([&"nocturnal", &"erratic", &"skittish"])
aspects = Array[ExtResource("8_aspect_type")]([ExtResource("2_aspect")])
instinct = ExtResource("3_instinct")
base_vitality = 45
base_power = 35
base_guard = 35
base_agility = 65
base_focus = 30
base_instinct = 40
growth_curve = &"steady"
base_bond_difficulty = 50
learnset = Array[ExtResource("9_move_type")]([ExtResource("4_move"), ExtResource("5_move"), ExtResource("6_move"), ExtResource("7_move")])
