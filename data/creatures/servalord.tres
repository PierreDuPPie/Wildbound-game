[resource]
script = ExtResource("1_species")
species_id = &"servalord"
atlas_number = 40
display_name = "Servalord"
short_description = "A phantom of the tall grass whose oversized ears track every heartbeat. It stalks with impossible patience, then strikes with lethal elegance."
rarity = &"rare"
animal_inspiration = "Serval (Leptailurus serval)"
habitat_tags = Array[StringName]([&"savannah", &"wetland", &"grassland"])
temperament_tags = Array[StringName]([&"patient", &"lethal", &"elegant"])
