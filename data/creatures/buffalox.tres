[resource]
script = ExtResource("1_species")
species_id = &"buffalox"
atlas_number = 20
display_name = "Buffalox"
short_description = "A massive, unyielding beast that forms formidable walls of muscle and horn. Never underestimate a herd in defense."
rarity = &"common"
animal_inspiration = "African Buffalo (Syncerus caffer)"
habitat_tags = Array[StringName]([&"savannah", &"grassland", &"woodland"])
temperament_tags = Array[StringName]([&"unpredictable", &"aggressive", &"herd"])
