[resource]
script = ExtResource("1_species")
species_id = &"aardvark"
atlas_number = 4
display_name = "Aardvark"
short_description = "A solitary digger that carves deep burrows and sniffs out trouble. Its strong claws can unearth ancient secrets."
rarity = &"common"
animal_inspiration = "Aardvark (Orycteropus afer)"
habitat_tags = Array[StringName]([&"savannah", &"grassland", &"scrubland"])
temperament_tags = Array[StringName]([&"solitary", &"docile", &"nocturnal"])
aspects = Array[ExtResource("8_aspect_type")]([ExtResource("2_aspect")])
instinct = ExtResource("3_instinct")
base_vitality = 48
base_power = 45
base_guard = 50
base_agility = 40
base_focus = 30
base_instinct = 45
growth_curve = &"steady"
base_bond_difficulty = 50
learnset = Array[ExtResource("9_move_type")]([ExtResource("4_move"), ExtResource("5_move"), ExtResource("6_move"), ExtResource("7_move")])
