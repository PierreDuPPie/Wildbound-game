[resource]
script = ExtResource("1_species")
species_id = &"rhinorex"
atlas_number = 8
display_name = "Rhinorex"
short_description = "A heavily armored tank of the savannah with a devastating charge. Its poor eyesight is offset by an acute sense of smell."
rarity = &"common"
animal_inspiration = "White Rhinoceros (Ceratotherium simum)"
habitat_tags = Array[StringName]([&"savannah", &"grassland", &"woodland"])
temperament_tags = Array[StringName]([&"docile", &"defensive", &"poor-sighted"])
aspects = Array[ExtResource("8_aspect_type")]([ExtResource("2_aspect")])
instinct = ExtResource("3_instinct")
base_vitality = 70
base_power = 65
base_guard = 75
base_agility = 25
base_focus = 20
base_instinct = 35
growth_curve = &"steady"
base_bond_difficulty = 50
learnset = Array[ExtResource("9_move_type")]([ExtResource("4_move"), ExtResource("5_move"), ExtResource("6_move"), ExtResource("7_move")])
