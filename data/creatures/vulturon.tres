[resource]
script = ExtResource("1_species")
species_id = &"vulturon"
atlas_number = 22
display_name = "Vulturon"
short_description = "A keen-eyed scavenger that circles endlessly in the thermals. It waits patiently for the right moment to descend."
rarity = &"common"
animal_inspiration = "Cape Vulture (Gyps coprotheres)"
habitat_tags = Array[StringName]([&"mountain", &"savannah", &"rocky"])
temperament_tags = Array[StringName]([&"patient", &"observant", &"opportunistic"])
