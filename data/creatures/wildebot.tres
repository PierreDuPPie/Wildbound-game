[resource]
script = ExtResource("1_species")
species_id = &"wildebot"
atlas_number = 30
display_name = "Wildebot"
short_description = "A relentless traveler that forms immense migratory herds. It relies on the safety of the collective to survive."
rarity = &"common"
animal_inspiration = "Blue Wildebeest (Connochaetes taurinus)"
