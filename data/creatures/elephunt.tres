[resource]
script = ExtResource("1_species")
species_id = &"elephunt"
atlas_number = 7
display_name = "Elephunt"
short_description = "A majestic giant possessing immense strength and deep wisdom. It shapes its environment and remembers every slight."
rarity = &"common"
animal_inspiration = "African Elephant (Loxodonta africana)"
habitat_tags = Array[StringName]([&"savannah", &"woodland", &"forest"])
temperament_tags = Array[StringName]([&"wise", &"protective", &"gentle"])
exploration_ability = ExtResource("7_ability")
aspects = Array[ExtResource("5_aspect_type")]([ExtResource("2_aspect")])
instinct = ExtResource("3_instinct")
base_vitality = 80
base_power = 60
base_guard = 60
base_agility = 20
base_focus = 20
base_instinct = 30
growth_curve = &"steady"
base_bond_difficulty = 50
learnset = Array[ExtResource("6_move_type")]([ExtResource("m_shell_slam"), ExtResource("m_scale_bash"), ExtResource("m_tusk_charge"), ExtResource("m_stampede")])
