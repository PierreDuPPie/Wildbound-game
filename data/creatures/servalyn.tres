[resource]
script = ExtResource("1_species")
species_id = &"servalyn"
atlas_number = 26
display_name = "Servalyn"
short_description = "A lanky, large-eared stalker that listens to the earth to find hidden prey. Its leaps are startlingly high."
rarity = &"common"
animal_inspiration = "Serval (Leptailurus serval)"
