[resource]
script = ExtResource("1_species")
species_id = &"chimpaz"
atlas_number = 18
display_name = "Chimpaz"
short_description = "An inventive and expressive fighter that uses tools gathered from the wild. It outsmarts stronger enemies with ease."
rarity = &"common"
animal_inspiration = "Common Chimpanzee (Pan troglodytes)"
