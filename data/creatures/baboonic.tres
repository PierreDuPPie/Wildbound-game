[resource]
script = ExtResource("1_species")
species_id = &"baboonic"
atlas_number = 16
display_name = "Baboonic"
short_description = "A highly social and intelligent primate that fiercely protects its troop. It uses loud barks to coordinate with allies."
rarity = &"common"
animal_inspiration = "Chacma Baboon (Papio ursinus)"
habitat_tags = Array[StringName]([&"savannah", &"rocky", &"woodland"])
temperament_tags = Array[StringName]([&"social", &"protective", &"loud"])
aspects = Array[ExtResource("5_aspect_type")]([ExtResource("2_aspect")])
instinct = ExtResource("3_instinct")
base_vitality = 50
base_power = 50
base_guard = 45
base_agility = 50
base_focus = 35
base_instinct = 45
growth_curve = &"steady"
base_bond_difficulty = 50
learnset = Array[ExtResource("6_move_type")]([ExtResource("m_badger_bite"), ExtResource("m_scrap_swipe"), ExtResource("m_primal_roar"), ExtResource("m_ground_slam")])
