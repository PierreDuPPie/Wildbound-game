[resource]
script = ExtResource("1_species")
species_id = &"warthusk"
atlas_number = 18
display_name = "Warthusk"
short_description = "A stubborn, tusked brawler caked in dried mud. It digs in its heels and refuses to fall, surviving blows that would flatten lesser creatures."
rarity = &"uncommon"
animal_inspiration = "Common Warthog (Phacochoerus africanus)"
habitat_tags = Array[StringName]([&"savannah", &"bushveld", &"mudflats"])
temperament_tags = Array[StringName]([&"stubborn", &"resilient", &"aggressive"])
