base_power = 55
base_guard = 35
base_agility = 60
base_focus = 30
base_instinct = 45
growth_curve = &"steady"
base_bond_difficulty = 50
learnset = Array[ExtResource("6_move_type")]([ExtResource("m_lookout_cry"), ExtResource("m_sun_skip"), ExtResource("m_ambush_pounce"), ExtResource("m_sun_dash")])
evolves_into = ExtResource("7_evolve")
evolution_level = 14
