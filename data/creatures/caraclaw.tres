[resource]
script = ExtResource("1_species")
species_id = &"caraclaw"
atlas_number = 27
display_name = "Caraclaw"
short_description = "An agile leaper with tufted ears, capable of swatting flying foes from the air. Its reflexes are second to none."
rarity = &"common"
animal_inspiration = "Caracal (Caracal caracal)"
habitat_tags = Array[StringName]([&"savannah", &"scrubland", &"woodland"])
temperament_tags = Array[StringName]([&"agile", &"stealthy", &"solitary"])
aspects = Array[ExtResource("5_aspect_type")]([ExtResource("2_aspect")])
instinct = ExtResource("3_instinct")
