[resource]
script = ExtResource("1_species")
species_id = &"gazellor"
atlas_number = 14
display_name = "Gazellor"
short_description = "An elegant sprinter with gilded horns that catch the sunlight. It outruns danger with grace and retaliates with dazzling solar bursts."
rarity = &"uncommon"
animal_inspiration = "Thomson's Gazelle (Eudorcas thomsonii)"
habitat_tags = Array[StringName]([&"savannah", &"grassland", &"plains"])
temperament_tags = Array[StringName]([&"alert", &"graceful", &"evasive"])
aspects = Array[ExtResource("8_aspect_type")]([ExtResource("2_aspect")])
instinct = ExtResource("3_instinct")
base_vitality = 45
base_power = 40
base_guard = 35
base_agility = 65
base_focus = 40
base_instinct = 45
growth_curve = &"steady"
base_bond_difficulty = 48
learnset = Array[ExtResource("9_move_type")]([ExtResource("4_move"), ExtResource("5_move"), ExtResource("6_move"), ExtResource("7_move")])
