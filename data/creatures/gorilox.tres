[resource]
script = ExtResource("1_species")
species_id = &"gorilox"
atlas_number = 17
display_name = "Gorilox"
short_description = "A muscular powerhouse that defends its family with chest-beating displays. Beneath its intimidating exterior lies a peaceful heart."
