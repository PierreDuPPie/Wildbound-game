[resource]
script = ExtResource("1_species")
species_id = &"ratelit"
atlas_number = 1
display_name = "Ratelit"
short_description = "A fearless burrow-raider that treats danger as a personal invitation."
rarity = &"uncommon"
animal_inspiration = "Honey badger (Mellivora capensis)"
habitat_tags = Array[StringName]([&"bushveld", &"savannah", &"rocky"])
