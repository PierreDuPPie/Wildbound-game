instinct = ExtResource("3_defiance")
base_vitality = 52
base_power = 49
base_guard = 46
base_agility = 38
base_focus = 28
base_instinct = 58
growth_curve = &"steady"
base_bond_difficulty = 68
learnset = Array[ExtResource("9_move_type")]([ExtResource("4_swipe"), ExtResource("5_bite"), ExtResource("6_move"), ExtResource("7_move")])
evolves_into = ExtResource("10_evolve")
evolution_level = 10
