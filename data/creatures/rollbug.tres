[resource]
script = ExtResource("1_species")
species_id = &"rollbug"
atlas_number = 2
display_name = "Rollbug"
short_description = "A starry-shelled dung beetle that navigates by the Milky Way and rolls massive environmental boulders."
rarity = &"common"
animal_inspiration = "African dung beetle (Scarabaeus zambesianus)"
habitat_tags = Array[StringName]([&"bushveld", &"savannah", &"trails"])
temperament_tags = Array[StringName]([&"diligent", &"observant", &"steady", &"cosmic"])
aspects = Array[ExtResource("8_aspect_type")]([ExtResource("2_aspect")])
instinct = ExtResource("3_instinct")
base_vitality = 48
base_power = 42
base_guard = 58
base_agility = 32
base_focus = 45
base_instinct = 46
growth_curve = &"steady"
base_bond_difficulty = 50
learnset = Array[ExtResource("9_move_type")]([ExtResource("4_move"), ExtResource("5_move"), ExtResource("6_move"), ExtResource("7_move")])
