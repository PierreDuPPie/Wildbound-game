[resource]
script = ExtResource("1_species")
species_id = &"pythonis"
atlas_number = 23
display_name = "Pythonis"
short_description = "A silent constrictor that senses the heat of its prey. It relies on overwhelming strength to secure a win."
rarity = &"common"
animal_inspiration = "Southern African Python (Python natalensis)"
habitat_tags = Array[StringName]([&"woodland", &"savannah", &"riverbank"])
temperament_tags = Array[StringName]([&"patient", &"stealthy", &"calm"])
