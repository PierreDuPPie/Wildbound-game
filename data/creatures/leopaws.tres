[resource]
script = ExtResource("1_species")
species_id = &"leopaws"
atlas_number = 19
display_name = "Leopaws"
short_description = "A stealthy ghost of the trees that strikes silently from above. It hoists its victories high into the branches."
rarity = &"common"
animal_inspiration = "African Leopard (Panthera pardus pardus)"
habitat_tags = Array[StringName]([&"woodland", &"savannah", &"forest"])
temperament_tags = Array[StringName]([&"stealthy", &"solitary", &"elusive"])
aspects = Array[ExtResource("5_aspect_type")]([ExtResource("2_aspect")])
instinct = ExtResource("3_instinct")
