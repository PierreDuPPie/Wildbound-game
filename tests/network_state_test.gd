extends SceneTree

const Ledger = preload("res://scripts/network/session_state.gd")
const Manager = preload("res://scripts/network/network_manager.gd")
var passed: int = 0
var failed: int = 0

func _init() -> void:
	_run.call_deferred()

func check(value: bool, label: String) -> void:
	if value:
		passed += 1
		print("[PASS] ", label)
	else:
		failed += 1
		push_error("[FAIL] " + label)

func make_ledger():
	var ledger = Ledger.new()
	ledger.add_player(1, "Host")
	ledger.add_player(2, "Friend")
	return ledger

func _run() -> void:
	var ledger = make_ledger()
	check(not ledger.add_player(2, "Duplicate"), "Duplicate registration cannot mint more goods")
	check(ledger.players[1].animals[0].id != ledger.players[2].animals[0].id, "Host creates unique session animal identities")
	check(not ledger.accept_presence(2, Vector3(INF, 0, 0), 0, "route_01_3d", 1), "Non-finite presence is rejected")
	check(not ledger.accept_presence(2, Vector3.ZERO, NAN, "route_01_3d", 1), "Non-finite yaw is rejected")
	check(not ledger.accept_presence(2, Vector3.ZERO, 0, "res://evil.gd", 1), "Unknown map and arbitrary resource path is rejected")
	check(ledger.accept_presence(2, Vector3(4, 0, 5), 0, "route_01_3d", 1), "Valid presence accepted")
	check(not ledger.accept_presence(2, Vector3(90, 0, 5), 0, "route_01_3d", 1.1), "Impossible same-map teleport rejected")
	check(ledger.request("trade", 1, 2, 2) == "Invitation sent.", "Trade invitation requires connected other player")
	check(ledger.offer(1, {"wood": 2}, "", 2).begins_with("Accept"), "Invitation cannot trade before consent")
	check(ledger.respond("trade", 1, true, 2).begins_with("There is no"), "Requester cannot accept own invitation")
	ledger.respond("trade", 2, true, 2)
	check(ledger.offer(1, {"wood": -1}, "", 3).begins_with("Invalid"), "Negative goods rejected")
	check(ledger.offer(1, {"wood": 25}, "", 3).begins_with("Invalid"), "Offering unowned goods rejected")
	check(ledger.offer(1, {"wood": 1.0}, "", 3).begins_with("Invalid"), "Non-integral payload types rejected")
	check(ledger.offer(1, {"gold": 1}, "", 3).begins_with("Invalid"), "Unknown goods rejected")
	check(ledger.offer(1, {}, ledger.players[2].animals[0].id, 3).begins_with("Invalid"), "Trading another keeper's animal rejected")
	var original_a: String = ledger.players[1].animals[0].id
	var original_b: String = ledger.players[2].animals[0].id
	ledger.offer(1, {"wood": 5}, original_a, 3)
	ledger.offer(2, {"stone": 3}, original_b, 3)
	var version: int = int(ledger.snapshot(1).trade.version)
	ledger.confirm(1, version, 4)
	check(ledger.players[1].goods.wood == 24, "First confirmation cannot mutate inventories")
	ledger.offer(2, {"stone": 4}, original_b, 4)
	check(ledger.snapshot(1).trade.confirmed.is_empty(), "Any offer change clears both confirmations")
	check(ledger.confirm(1, version, 4).begins_with("The offer changed"), "Stale confirmation rejected")
	version = int(ledger.snapshot(1).trade.version)
	ledger.confirm(1, version, 5)
	check(ledger.confirm(2, version, 5).begins_with("Trade complete"), "Both confirmations atomically commit trade")
	check(ledger.players[1].goods.wood == 19 and ledger.players[2].goods.wood == 29, "Goods transfer conserves total wood")
	check(ledger.players[1].goods.stone == 20 and ledger.players[2].goods.stone == 12, "Goods transfer conserves total stone")
	check(ledger.players[1].animals[1].id == original_b and ledger.players[2].animals[1].id == original_a, "Animal identities exchanged without duplication")
	check(ledger.confirm(2, version, 5) == "No active trade.", "Completed trade cannot be replayed")
	ledger.players[1].animals.pop_back()
	ledger.request("trade", 1, 2, 6)
	ledger.respond("trade", 2, true, 6)
	check(ledger.offer(1, {}, ledger.players[1].animals[0].id, 7).begins_with("Invalid"), "Last animal cannot be traded away")
	ledger.cancel(1)
	ledger.request("battle", 1, 2, 8)
	check(ledger.choose(1, "burst", 8) == "No active battle.", "Battle waits for both keeper consent")
	ledger.respond("battle", 2, true, 8)
	ledger.choose(1, "burst", 9)
	check(ledger.snapshot(2).battle.choices[1] == "locked", "Opponent move hidden until both choices are locked")
	check(ledger.choose(1, "attack", 9).begins_with("Your move is locked"), "Locked move cannot be overwritten")
	ledger.choose(2, "guard", 9)
	check(ledger.snapshot(1).battle.hp[2] == 89 and ledger.snapshot(1).battle.hp[1] == 100, "Guard reduces burst damage and simultaneous turns resolve")
	check(ledger.choose(1, "burst", 10).begins_with("Burst can"), "Burst is limited to once per battle")
	for round_number in range(5):
		ledger.choose(1, "attack", 11 + round_number)
		ledger.choose(2, "attack", 11 + round_number)
	check(ledger.snapshot(1).battle.status == "finished", "Battle reaches a completed result")
	check(ledger.players[1].animals[0].has("name") and ledger.players[1].goods.wood == 19, "Battles neither remove animals nor wager goods")
	ledger.cancel(1)
	ledger.request("trade", 1, 2, 20)
	ledger.remove_player(2)
	check(ledger.snapshot(1).trade.is_empty() and ledger.players.size() == 1, "Disconnect cancels pending interactions and removes player")
	ledger = make_ledger()
	ledger.request("trade", 1, 2, 1)
	check(ledger.expire(32) and not ledger.busy(1), "Invitations expire and release both keepers")
	ledger.request("trade", 1, 2, 33)
	ledger.respond("trade", 2, true, 33)
	ledger.offer(1, {"wood": 5}, "", 34)
	ledger.offer(2, {"stone": 4}, "", 34)
	version = int(ledger.snapshot(1).trade.version)
	ledger.confirm(1, version, 35)
	ledger.players[1].goods.wood = 0
	check(not ledger.confirm(2, version, 35).begins_with("Trade complete") and ledger.players[2].goods.stone == 16, "Commit rechecks both inventories without partial mutation")
	ledger.cancel(1)
	ledger.request("trade", 1, 2, 40)
	ledger.respond("trade", 2, true, 40)
	check(ledger.offer(1, {"wood": 0}, "", 161) == "Trade expired." and not ledger.busy(1), "A late offer cannot revive an expired trade")
	ledger.request("battle", 1, 2, 170)
	ledger.respond("battle", 2, true, 170)
	check(ledger.choose(1, "attack", 291) == "Battle expired." and not ledger.busy(1), "A late move cannot revive an expired battle")
	ledger.request("trade", 1, 2, 300)
	ledger.accept_presence(2, Vector3.ZERO, 0, "sanctuary_town", 300)
	check(not ledger.busy(1), "Region transition cancels an interaction even before first presence packet")
	ledger = make_ledger()
	check(ledger.add_player(3, "Third") and ledger.add_player(4, "Fourth") and not ledger.add_player(5, "Fifth"), "Session capacity is bounded to four keepers")
	ledger.players[2].position = Vector3(80, 0, 0)
	check(ledger.request("trade", 1, 2, 1).begins_with("Move closer"), "Distant keepers cannot start an interaction")
	ledger.players[2].position = Vector3(5, 0, 5)
	ledger.request("battle", 1, 2, 1)
	ledger.respond("battle", 2, true, 1)
	for round_number in range(20):
		ledger.choose(1, "guard", 2 + round_number)
		ledger.choose(2, "guard", 2 + round_number)
	check(ledger.snapshot(1).battle.status == "finished" and ledger.snapshot(1).battle.winner == 0, "Endless guarding terminates as a draw at twenty rounds")
	var manager = Manager.new()
	check(not manager._valid_command("trade_offer", {"goods": {"wood": "lots"}, "animal_id": "", "id": 1}), "Malformed command payload rejected")
	check(not manager._valid_command("battle_action", {"action": "attack", "id": 1}), "Battle commands require a round to reject old-turn replay")
	check(not manager._valid_command("trade_confirm", {"version": 1}), "Confirmations require interaction identity to prevent cross-trade replay")
	check(not manager._valid_name("<script>"), "Markup keeper names rejected")
	check(not manager._valid_address("https://example.com/"), "Host input is address, not an arbitrary URL")
	check(not manager._valid_command("trade_offer", {"goods": {"wood": 1}, "animal_id": "a".repeat(3000), "id": 1}), "Oversized command payload rejected")
	manager.name = "NetworkReplayTest"
	root.add_child(manager)
	manager._ledger = make_ledger()
	manager._ledger.request("battle", 1, 2, 1)
	manager._ledger.respond("battle", 2, true, 1)
	var battle_id: int = int(manager._ledger.snapshot(1).battle.id)
	manager._handle_command(1, "battle_action", {"action": "burst", "id": battle_id, "round": 0})
	check(manager._ledger.snapshot(1).battle.choices.is_empty(), "Manager rejects a real stale round command before altering combat")
	manager._ledger.cancel(1)
	manager._ledger.request("trade", 1, 2, 1)
	manager._ledger.respond("trade", 2, true, 1)
	manager._handle_command(1, "trade_confirm", {"id": battle_id, "version": 0})
	check(manager._ledger.snapshot(1).trade.confirmed.is_empty(), "Manager rejects old interaction identity before confirming a new trade")
	manager.free()
	print("NETWORK STATE TESTS: %d passed, %d failed" % [passed, failed])
	quit(0 if failed == 0 else 1)
